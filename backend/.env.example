# Reference only. Django does not automatically load this file.
APP_ENV=local
DJANGO_SECRET_KEY=
DATABASE_URL=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:4210,http://127.0.0.1:4210
# Set to the exact disposable database name only when explicitly loading demo data.
DEMO_DATABASE_CONFIRMED=
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000
DB_CONN_MAX_AGE=0
# Production requires verified TLS/CA in DATABASE_URL and exact HTTPS frontend origins.
DJANGO_TRUST_PROXY=false
DJANGO_PROXY_CONFIRMATION=

